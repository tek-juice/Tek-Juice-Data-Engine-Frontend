# Data Engine Frontend — Production Configuration

# API Gateway Base URL
VITE_API_BASE_URL=http://54.86.109.228:8000

# WebSocket URL
VITE_WS_BASE_URL=ws://54.86.109.228:8000

# Environment
VITE_ENV=production

# Auth Token Storage Keys
VITE_TOKEN_STORAGE_KEY=data_engine_token
VITE_REFRESH_TOKEN_STORAGE_KEY=data_engine_refresh_token

# API Request Timeout (ms)
VITE_API_TIMEOUT=30000

# WebSocket Reconnect Settings
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# API Version prefix
VITE_API_VERSION=v1
