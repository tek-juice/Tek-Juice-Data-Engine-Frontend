# ── Production environment — set VITE_API_BASE_URL to your deployed gateway URL ──
# Example: https://api.yourdomain.com
# This file is intentionally left with a placeholder — fill in before deploying.

# API Gateway Base URL (replace with your production domain)
VITE_API_BASE_URL=https://api.yourdomain.com

# WebSocket URL (replace with your production domain)
VITE_WS_BASE_URL=wss://api.yourdomain.com

# Environment
VITE_ENV=production

# Auth Token Storage Keys
VITE_TOKEN_STORAGE_KEY=data_engine_token
VITE_REFRESH_TOKEN_STORAGE_KEY=data_engine_refresh_token

# API Request Timeout (ms)
VITE_API_TIMEOUT=30000

# WebSocket Reconnect Settings
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10
