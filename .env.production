# ── Production environment ──

# API Gateway Base URL — MUST be empty so all API calls are relative
# and proxied through nginx (avoids CORS — browser never touches :9600 directly)
VITE_API_BASE_URL=

# WebSocket URL — direct connection is fine (not same-origin restricted)
VITE_WS_BASE_URL=ws://54.86.109.228:8000

# Environment
VITE_ENV=production

# Auth Token Storage Keys
VITE_TOKEN_STORAGE_KEY=data_engine_token
VITE_REFRESH_TOKEN_STORAGE_KEY=data_engine_refresh_token

# API Request Timeout (ms)
VITE_API_TIMEOUT=30000

# WebSocket Reconnect Settings
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10
