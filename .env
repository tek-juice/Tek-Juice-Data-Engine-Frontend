# Data Engine Frontend Configuration

# API Gateway Base URL — empty = relative URLs, proxied by nginx in prod / Vite in dev
VITE_API_BASE_URL=

# WebSocket URL — direct to backend (WebSocket proxying requires nginx extra config)
VITE_WS_BASE_URL=ws://54.86.109.228:9600

# Environment
VITE_ENV=development

# Auth Token Storage Key
VITE_TOKEN_STORAGE_KEY=data_engine_token
VITE_REFRESH_TOKEN_STORAGE_KEY=data_engine_refresh_token

# API Request Timeout (ms)
VITE_API_TIMEOUT=30000

# WebSocket Reconnect Settings
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10
